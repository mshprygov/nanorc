## Syntax highlighting for C and C++ files.

## This file was heavily modified by Mikhail Shprygov
## Since I only write in C for GCC on Linux,
## I am not sure how it will behave with C++ or other platform
## For any questions and suggestions find me on github.com/mshprygov

syntax c "\.([ch](pp|xx)?|C|cc|c\+\+|cu|H|hh|ii?)$"
header "-\*-.*\<C(\+\+)?((;|[[:blank:]]).*)?-\*-"
magic "^(C|C\+\+) (source|program)"
comment "//"

# Operators
color brightgreen "[][}{)(,.;:/=+*!?&|^~><-]+"
color brightgreen "[&|^~><]"
color brightgreen "\<(and|or|xor|not)\>"
color brightyellow "[)(]"
color brightgreen "[][]"
color brightgreen "[}{]"
color green "[;]"

# Base types and keywords
color green "\<(auto|break|case|bool|char|const|continue|default|do|double|else|enum|extern|float|for|goto|if|inline|int|long|register|return|restrict|short|signed|sizeof|static|struct|switch|typedef|union|unsigned|void|volatile|while|size_t)\>"

# More types
color green "\<(_(Alignas|Alignof|Atomic|Bool|Complex|Generic|Imaginary|Noreturn|Static_assert|Thread_local))\>"
color green "\<(class|explicit|friend|mutable|namespace|override|private|protected|public|register|template|this|typename|using|virtual|volatile)\>"
color green "\<(bool|alignas|alignof|constexpr|false|nullptr|static_assert|thread_local|true|typeof|typeof_unqual|_BitInt|_Decimal(32|64|128))\>"
color green "\<([[:lower:]][[:lower:]_]*|(u_?)?int(8|16|32|64))_t\>"
color green "\<(float_t|double_t|u?intptr_t|u?intmax_t)\>"
color green "\<(is(alnum|alpha|blank|cntrl|digit|graph|lower|print|punct|space|upper|xdigit))\>"
color green "\<(time_t|clock_t|timespec|timeval)\>"

# Constants
color brightred "\<[A-Z_][0-9A-Z_]*\>"
# Labels
color brightmagenta "^[[:blank:]]*[A-Z_a-z][0-9A-Z_a-z]*:[[:blank:]]*$"
color normal ":[[:blank:]]*$"
# Special Constants
color brightred "\<(stdin|stdout|stderr)\>"
color brightmagenta "\<(true|false|this)\>"
# Special types
color green "\<(FILE|DIR)\>"
color lightgreen "\<(typedef)\>"
color lightgreen "\<(typeof|sizeof)\>"
# Numbers
color brightmagenta "\<[0-9]+(\.[0-9]+)?\>"

# More keywords and builtin functions
color normal "\<(a?cosh?|a?sinh?|a?tanh?)\>"
color normal "\<(pow|sqrt|cbrt|exp|log)\>"
color normal "\<(ceil|floor|round|trunc)\>"
color normal "\<(f?(max|min|abs|dim))\>"
color normal "\<((f|s)?printf|(f|s)?scanf|snprintf)\>"
color normal "\<(f?getc|f?gets|f?putc|f?puts|getchar|putchar|ungetc)\>"
color normal "\<(fopen|fclose|freopen|fflush|setbuf|setvbuf|fread|fwrite|fgetpos|ftell|fseek|fsetpos|rewind|remove|rename|tmpfile|tmpnam)\>"
color normal "\<(feof|ferror|clearerr|perror|setbuf|setvbuf)\>"
color normal "\<(malloc|realloc|free|calloc|new|delete)\>"
color normal "\<(tolower|toupper)\>"
color normal "\<(strn?cpy|strn?cat|strn?cmp|strn?dup|strlen|strr?chr|strstr|strtok|strc?spn|pbrk|strcoll|strxfrm)\>"
color normal "\<(memcpy|memmove|memset|memcmp|memchr)\>"
color normal "\<(s?rand|time|clock|timespec_get|difftime)\>"
# Deprecated
color normal,white "\<(gets)\>"

# Flow control
color brightyellow "\<(if|else|for|while|do|switch|case|default)\>"
color yellow "\<(try|throw|catch|operator|new|delete)\>"
color magenta "\<(break|continue|goto|return|exit|abort)\>"

# Single-quoted stuff (characters, backslash escapes, hex and octal byte codes)
color brightmagenta "'([^'\]|\\(["'\abfnrtv]|x[[:xdigit:]]{1,2}|[0-3]?[0-7]{1,2}))'"

# GCC builtins
color yellow "__attribute__[[:blank:]]*\(\([^)]*\)\)|__(aligned|asm|builtin|hidden|inline|packed|restrict|section|typeof|weak)__"

# Strings and names of included files
color brightyellow "\"([^"]|\\")*"|#[[:blank:]]*include[[:blank:]]*<[^>]+>"

# Preprocessor directives
color brightgreen start="^[[:blank:]]*#[[:blank:]]*(if(n?def)?|elif|warning|error|pragma)\>" end="(\`|[^\])$"
color brightgreen "^[[:blank:]]*#[[:blank:]]*((define|else|endif|include(_next)?|line|undef)\>|$)"

# Trailing whitespace
color ,green "[[:space:]]+$"

# Format specifiers
#color cyan "%-?[0-9]*(\.[0-9]+)?(z|ll|l|h)?(d|i|u|o|x|X|f|F|e|E|g|G|a|A|c|s|p|n)"
#color cyan "\\"
# Fix \0 and \n inside single quotes
color brightmagenta "'(\\0|\\n)'"

# Comments
color brightblue "//[^"]*$|(^|[[:blank:]])//.*"
color brightblue start="/\*" end="\*/"

# Reminders
color brightwhite,blue "\<(FIXME|TODO|XXX)\>"
