## Syntax highlighting for C and C++ files.

## This file was modified by Mikhail Shprygov
## Since I only write in C for GCC on Linux,
## I am not sure about its behaviour with C++
## For contact find me on github.com/mshprygov

syntax c "\.([ch](pp|xx)?|C|cc|c\+\+|cu|H|hh|ii?)$"
header "-\*-.*\<C(\+\+)?((;|[[:blank:]]).*)?-\*-"
magic "^(C|C\+\+) (source|program)"
comment "//"

# =======================================
#  Operators, Punctuation, Brackets
# =======================================
color green "[-+,.;:/=*!?%&|^~><]+"
color green "[&|^~><]"
color green "\<(and|or|xor|not)\>"
color brightgreen "[)(]"
color brightgreen "[;,]"
color brightgreen "[}{]"
color normal "[][]"

# =======================================
#  Base Keywords and Types
# =======================================
## Base C keywords
color brightblue "\<(auto|break|case|bool|char|const|continue|default|do|double|else|enum|extern|float|for|goto|if|inline|int|long|register|return|restrict|short|signed|sizeof|static|struct|switch|typedef|union|unsigned|void|volatile|while|size_t)\>"
## More types
color brightblue "\<(_(Alignas|Alignof|Atomic|Bool|Complex|Generic|Imaginary|Noreturn|Static_assert|Thread_local))\>"
color brightblue "\<(class|explicit|friend|mutable|namespace|override|private|protected|public|register|template|this|typename|using|virtual|volatile)\>"
## C23 adds
color brightblue "\<(bool|alignas|alignof|constexpr|false|nullptr|static_assert|thread_local|true|typeof|typeof_unqual|_BitInt|_Decimal(32|64|128))\>"
## Stdint.h
color brightblue "\<([[:lower:]][[:lower:]_]*|(u_?)?int(8|16|32|64))_t\>"
## Math.h types
color brightblue "\<(float_t|double_t|u?intptr_t|u?intmax_t)\>"
## Time.h types
color brightblue "\<(time_t|clock_t|timespec|timeval)\>"
## User defined types
color brightblue "\<(struct|union|enum|typedef)\>"
## Storage types
color brightblue "\<(auto|extern|static|register)\>"
## Conditionals and Flow Control
color brightblue "\<(if|else|for|while|do|switch|case|default)\>"
color brightblue "\<(try|throw|catch|operator|new|delete)\>"
color brightblue "\<(break|continue|goto|return|exit|abort)\>"

# =======================================
#  Macros, Constants and Numbers
# =======================================
## Constants and macros
color brightred "\<[A-Z_][0-9A-Z_]*\>"
## Labels
color green "^[[:blank:]]*[A-Z_a-z][0-9A-Z_a-z]*:[[:blank:]]*$"
color green ":[[:blank:]]*$"
## Special constants and system tokens
color brightblue "\<(FILE|DIR)\>"
color cyan "\<(true|false)\>"
color cyan "\<(this)\>"
#color cyan "\<(NULL|EOF)\>"
color green "\<(stdin|stdout|stderr)\>"
## Numbers
color cyan "\<[0-9]+\.?[0-9]*[eE][+-]?[0-9]+[fF]?\>"
color cyan "\<0[xX][0-9a-fA-F]+[uUlL]*\>"
color cyan "\<[0-9]+(\.[0-9]+)?\>"

# =======================================
#  Built-in Functions
# =======================================
## Math.h functions
#color yellow "\<(a?cosh?|a?sinh?|a?tanh?)\>"
#color yellow "\<(pow|sqrt|cbrt|exp|log)\>"
#color yellow "\<(ceil|floor|round|trunc)\>"
#color yellow "\<(f?(max|min|abs|dim))\>"
## Stdio.h functions
#color yellow "\<((f|s)?printf|(f|s)?scanf|snprintf)\>"
#color yellow "\<(f?getc|f?gets|f?putc|f?puts|getchar|putchar|ungetc)\>"
## Stdlib.h functions
#color yellow "\<(feof|ferror|clearerr|perror|setbuf|setvbuf)\>"
#color yellow "\<(malloc|realloc|free|calloc|new|delete)\>"
## String.h functions
#color yellow "\<(strn?cpy|strn?cat|strn?cmp|strn?dup|strlen|strr?chr|strstr|strtok|strc?spn|pbrk|strcoll|strxfrm)\>"
#color yellow "\<(memcpy|memmove|memset|memcmp|memchr)\>"
## Ctype.h functions
#color yellow "\<(tolower|toupper)\>"
#color yellow "\<(is(alnum|alpha|blank|cntrl|digit|graph|lower|print|punct|space|upper|xdigit))\>"
## Time.h functions
#color yellow "\<(s?rand|time|clock|timespec_get|difftime)\>"
## Files handling
#color yellow "\<(fopen|fclose|freopen|fflush|setbuf|setvbuf|fread|fwrite|fgetpos|ftell|fseek|fsetpos|rewind|remove|rename|tmpfile|tmpnam)\>"
## GCC builtins
color yellow "__attribute__[[:blank:]]*\(\([^)]*\)\)|__(aligned|asm|builtin|hidden|inline|packed|restrict|section|typeof|weak)__"
## Deprecated
#color yellow,white "\<(gets)\>"

# =======================================
#  Strings and Literals
# =======================================
## Single-quoted stuff (characters, backslash escapes, hex and octal byte codes)
color brightyellow "'([^'\]|\\(["'\abfnrtv]|x[[:xdigit:]]{1,2}|[0-3]?[0-7]{1,2}))'"
## Strings and names of included files
color brightmagenta "\"([^"]|\\")*"|#[[:blank:]]*include[[:blank:]]*<[^>]+>"
## Format specifiers
#color magenta "%-?[0-9]*(\.[0-9]+)?(z|ll|l|h)?(d|i|u|o|x|X|f|F|e|E|g|G|a|A|c|s|p|n)"
## Highlight escape inside strings
color magenta "\\"
## Fix \0 and \n inside single quotes
color brightyellow "'(\\0|\\n)'"
## Preprocessor directives
color green start="^[[:blank:]]*#[[:blank:]]*(if(n?def)?|elif|warning|error|pragma)\>" end="(\`|[^\])$"
color green "^[[:blank:]]*#[[:blank:]]*((define|else|endif|include(_next)?|line|undef)\>|$)"
## Fix hash on preprocessor lines
color normal "^[[:blank:]]*#"

# =======================================
#  Comments, Notes, Reminders
# =======================================
## Trailing whitespace
color ,green "[[:space:]]+$"
## Comments
color blue "//[^"]*$|(^|[[:blank:]])//.*"
color blue start="/\*" end="\*/"
## Reminders
color brightwhite,blue "\<(FIXME|TODO|XXX)\>"
