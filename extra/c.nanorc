## Syntax highlighting for C and C++ files.

syntax c "\.([ch](pp|xx)?|C|cc|c\+\+|cu|H|hh|ii?)$"
header "-\*-.*\<C(\+\+)?((;|[[:blank:]]).*)?-\*-"
magic "^(C|C\+\+) (source|program)"
comment "//"

# Operators
color brightgreen "[][}{)(,.;:/=+*!?&|^~><-]+"
# Bitwise
color brightgreen "[&|^~><]"
# Brackets
color magenta "[)(]"
# Curlies
color magenta "[}{]"

# Constants
color brightred "\<[A-Z_][0-9A-Z_]*\>"
# Labels
color brightmagenta "^[[:blank:]]*[A-Z_a-z][0-9A-Z_a-z]*:[[:blank:]]*$"
color normal ":[[:blank:]]*$"
# Special Constants
color yellow "\<(true|false|stdin|stdout|stderr)\>"
# Numbers
color brightmagenta "\<[0-9]+(\.[0-9]+)?\>"

# Types and related keywords
color green "\<(auto|bool|char|const|double|enum|extern|float|inline|int|long|restrict|short|signed|sizeof|static|struct|typedef|union|unsigned|void|size_t)\>"
color green "\<(_(Alignas|Alignof|Atomic|Bool|Complex|Generic|Imaginary|Noreturn|Static_assert|Thread_local))\>"
color green "\<(class|explicit|friend|mutable|namespace|override|private|protected|public|register|template|this|typename|using|virtual|volatile)\>"
# Special types
color green "\<(FILE|DIR)\>"
color brightgreen "\<(typedef)\>"

# [--- math.h ---]
color green "\<([[:lower:]][[:lower:]_]*|(u_?)?int(8|16|32|64))_t\>"
color green "\<(float_t|double_t|u?intptr_t|u?intmax_t)\>"
# Math functions
color cyan "\<(a?cosh?|a?sinh?|a?tanh?)\>"
color cyan "\<(pow|sqrt|cbrt|exp|log)\>"
color cyan "\<(ceil|floor|round|trunc)\>"
#color cyan "\<(f?(max|min|abs|dim))\>"

# [--- stdio.h ---]
# Formatted input/output
color cyan "\<((f|s)?printf|(f|s)?scanf|snprintf)\>"
# Unformatted input/output
color cyan "\<(f?getc|f?gets|f?putc|f?puts|getchar|putchar|ungetc)\>"
# Deprecated
color cyan,red "\<(gets)\>"
# File Handling
color cyan "\<(fopen|fclose|freopen|fflush|setbuf|setvbuf|fread|fwrite|fgetpos|ftell|fseek|fsetpos|rewind|remove|rename|tmpfile|tmpnam)\>"
# Error and Buffering Control
color cyan "\<(feof|ferror|clearerr|perror|setbuf|setvbuf)\>"

# [--- stdlib.h ---]
# Memory management
color cyan "\<(malloc|realloc|free|calloc)\>"

# [--- ctype.h ---]
# Classification
color green "\<(is(alnum|alpha|blank|cntrl|digit|graph|lower|print|punct|space|upper|xdigit))\>"
# Transformation
color cyan "\<(tolower|toupper)\>"

# [--- string.h ---]
# String handling
color cyan "\<(strn?cpy|strn?cat|strn?cmp|strn?dup|strlen|strr?chr|strstr|strtok|strc?spn|pbrk|strcoll|strxfrm)\>"
# Memory operations
color cyan "\<(memcpy|memmove|memset|memcmp|memchr)\>"

# [--- time.h ---]
color cyan "\<(s?rand|time|clock|timespec_get|difftime)\>"
# Time types
color green "\<(time_t|clock_t|timespec|timeval)\>"

# Flow control
color brightyellow "\<(if|else|for|while|do|switch|case|default)\>"
color brightyellow "\<(try|throw|catch|operator|new|delete)\>"
color magenta "\<(break|continue|goto|return|exit|abort)\>"

# Single-quoted stuff (characters, backslash escapes, hex and octal byte codes)
color brightmagenta "'([^'\]|\\(["'\abfnrtv]|x[[:xdigit:]]{1,2}|[0-3]?[0-7]{1,2}))'"

# GCC builtins
color cyan "__attribute__[[:blank:]]*\(\([^)]*\)\)|__(aligned|asm|builtin|hidden|inline|packed|restrict|section|typeof|weak)__"

# Strings and names of included files
color brightyellow ""([^"]|\\")*"|#[[:blank:]]*include[[:blank:]]*<[^>]+>"

# Preprocessor directives
color brightcyan start="^[[:blank:]]*#[[:blank:]]*(if(n?def)?|elif|warning|error|pragma)\>" end="(\`|[^\])$"
color brightcyan "^[[:blank:]]*#[[:blank:]]*((define|else|endif|include(_next)?|line|undef)\>|$)"

# Reminders
color brightwhite,blue "\<(FIXME|TODO|XXX)\>"

# Trailing whitespace
color ,green "[[:space:]]+$"

# Format specifiers
#color yellow "%-?[0-9]*(\.[0-9]+)?(z|ll|l|h)?(d|i|u|o|x|X|f|F|e|E|g|G|a|A|c|s|p|n)"
color green "\\"
# fix \0 and \n inside single quotes
color brightmagenta "'(\\0|\\n)'"

# Comments
color brightblue "//[^"]*$|(^|[[:blank:]])//.*"
color brightblue start="/\*" end="\*/"
