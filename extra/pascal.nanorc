## Syntax highlighting for Free Pascal

## This file was heavily modified by Mikhail Shprygov
## I write in Free Pascal for FPC on Linux only
## and I have no idea how this may behave on other dialect/platform
## For any questions and suggestions find me on github.com/mshprygov

#syntax "pascal" "\.pas$" "\.pp$"
syntax "pascal" "\.(pas|pp|lpr)$"
comment "//"

# Numbers.
color brightcyan "\<[0-9]+(\.[0-9]+)?\>"

# Reserved Keywords Turbo Pascal
icolor brightblue "\<(and|array|asm|begin|break|case|const|constructor|continue|destructor|div|do|downto|else|end|false|file|for|function|goto|if|implementation|in|inline|interface|label|mod|nil|not|object|of|on|operator|or|packed|procedure|program|record|repeat|set|shl|shr|then|to|true|type|unit|until|uses|var|while|with|xor)\>"

# Reserved Keywords Object Pascal
icolor brightblue "\<(as|class|constref|dispose|except|exit|exports|finalization|finally|inherited|initialization|is|library|new|on|out|property|raise|self|threadvar|try)\>"

# Modifiers
icolor brightyellow "\<(absolute|abstract|alias|assembler|cdecl|cppdecl|default|export|external|forward|generic|index|local|nostackframe|oldfpccall|override|pascal|private|protected|public|published|register|reintroduce|safecall|softfloat|specialize|stdcall|virtual|far|near)\>"

# DataTypes
icolor brightgreen "\<(string|integer|uint64|int64|real|char|boolean|word|longint|textfile|file|text)\>"
# More String DataTypes
icolor brightgreen "\<p?(ansi|short|unicode|wide)?(string|char)\>"

# Other
icolor yellow "\<(lowercase|assignfile|Close|ParamStr|ParamCount|Length|SetLength|Inc|Dec|GetUserDir|Assign|Rewrite|CompareStr|Delete|CompareText|Pos|LeftStr|RightStr|Copy|FileExists|Reset|ReadLn|Read|WriteLn|Write|Eof|Eol|Nil|ClrScr|TextColor|TextBackground)\>"

# More builtins
icolor cyan "\<(random(ize)?|randseed)\>"
icolor cyan "\<(floor|ceil)\>"

# File Handling
icolor yellow "\<(eol|eoln|eof|seekeoln|seekeof|assign|append|close|closefile|reset|rewrite|seek)\>"

# Special Constants
icolor cyan "\<(true|false)\>"
icolor brightred "\<(nil|nan)\>"

# Flow control
icolor magenta "\<(break|continue|exit|label|goto)\>"

# Operators
color brightyellow "[][}{)(,.;:/=+*!?`^@&~><-]+"
# Escape, Pointers and Character Expression
color cyan "[&@#$^]"
# Brackets
color brightyellow "[)(]"
# Squares
#color yellow "[][]"

# Text Strings
color brightmagenta "'[^']*'"

# TODO
# Compiler directives
#color red,white "{$*}"

# Comments
color green "//.*$"
color green start="\{" end="\}"
color green start="\(\*" end="\*\)"

# Reminders
color black,green "\<(fixme|todo|xxx)\>"
